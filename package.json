{
  "name": "mips-studio",
  "version": "1.0.0",
  "description": "A lightweight MIPS assembly editor and simulator",
  "author": "MIPS Studio",
  "main": "main.cjs",
  "desktopName": "com.mipsstudio.app",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win nsis",
    "package:deb": "electron-builder --linux deb"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.mipsstudio.app",
    "productName": "MIPS Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "index.html",
      "styles.css",
      "app.js",
      "simulator.js",
      "README.md"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "deb",
      "category": "Development",
      "maintainer": "MIPS Studio"
    }
  }
}
